{
    "name": "airwise-server",
    "version": "1.0.0",
    "description": "Backend server for AirWise Air Quality Dashboard",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "init-db": "node database/migrations/init.js",
        "migrate": "sequelize-cli db:migrate",
        "migrate:undo": "sequelize-cli db:migrate:undo",
        "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
        "migrate:status": "sequelize-cli db:migrate:status",
        "seed": "sequelize-cli db:seed:all",
        "seed:undo": "sequelize-cli db:seed:undo",
        "seed:undo:all": "sequelize-cli db:seed:undo:all",
        "db:setup": "npm run migrate && npm run seed"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "cron": "^4.4.0",
        "dotenv": "^16.3.1",
        "error-stack-parser": "^2.1.4",
        "express": "^4.18.2",
        "express-rate-limit": "^7.2.1",
        "express-validator": "^7.2.1",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "json2csv": "^6.0.0-alpha.2",
        "jsonwebtoken": "^9.0.3",
        "kafkajs": "^2.2.4",
        "morgan": "^1.10.0",
        "mysql2": "^3.15.1",
        "node-cron": "^3.0.3",
        "rate-limit-redis": "^4.2.0",
        "sequelize": "^6.35.1"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "sequelize-cli": "^6.6.2"
    }
}
